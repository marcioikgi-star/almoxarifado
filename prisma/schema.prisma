generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) usada só pelas migrações. No Supabase: porta 5432.
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ADMIN
  ALMOXARIFE
}

model Usuario {
  id               String    @id @default(cuid())
  email            String    @unique
  nome             String
  senhaHash        String
  papel            Papel     @default(ALMOXARIFE)
  // Obriga a trocar a senha no próximo acesso (senha inicial ou redefinida pelo administrador).
  trocarSenha      Boolean   @default(true)
  ativo            Boolean   @default(true)
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  criadoEm         DateTime  @default(now())

  sessoes       Sessao[]
  movimentacoes Movimentacao[]
}

model Sessao {
  // Hash SHA-256 do token do cookie; o token em si nunca é gravado.
  id        String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
  DEVOLUCAO
}

model Item {
  id            String   @id @default(cuid())
  codigo        String   @unique
  descricao     String
  categoria     String?
  // Sigla da unidade de medida (ver UnidadeMedida). Mudar a sigla lá atualiza os itens.
  unidade       String   @default("UN")
  unidadeMedida UnidadeMedida @relation(fields: [unidade], references: [sigla], onUpdate: Cascade)
  codigoBarras  String?  @unique
  fabricante    String?
  referencia    String?
  localizacao   String?
  estoqueMinimo Decimal  @default(0) @db.Decimal(14, 3)
  // Saldo e custo médio são mantidos a cada movimentação (ver src/lib/estoque.ts).
  saldo         Decimal  @default(0) @db.Decimal(14, 3)
  custoMedio    Decimal  @default(0) @db.Decimal(14, 4)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  movimentacoes Movimentacao[]

  @@index([descricao])
}

model UnidadeMedida {
  id       String   @id @default(cuid())
  sigla    String   @unique
  nome     String
  // Agrupa a lista no cadastro de itens: Contagem, Comprimento, Área, Volume, Massa, Tempo e serviço, Outras.
  grupo    String   @default("Outras")
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  itens Item[]
}

model Fornecedor {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String?  @unique
  contato  String?
  criadoEm DateTime @default(now())

  movimentacoes Movimentacao[]
}

model Projeto {
  id       String   @id @default(cuid())
  nome     String
  cliente  String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  movimentacoes Movimentacao[]
}

model Movimentacao {
  id            String           @id @default(cuid())
  tipo          TipoMovimentacao
  itemId        String
  item          Item             @relation(fields: [itemId], references: [id])
  // Variação aplicada ao saldo: positiva em entradas e devoluções, negativa em saídas;
  // em ajustes, a diferença entre o saldo contado e o anterior.
  quantidade    Decimal          @db.Decimal(14, 3)
  custoUnitario Decimal          @db.Decimal(14, 4)
  saldoApos     Decimal          @db.Decimal(14, 3)
  fornecedorId  String?
  fornecedor    Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  projetoId     String?
  projeto       Projeto?         @relation(fields: [projetoId], references: [id])
  documento     String?
  responsavel   String?
  observacao    String?
  // Quem registrou no sistema (pode ser diferente de quem retirou o material).
  usuarioId     String?
  usuario       Usuario?         @relation(fields: [usuarioId], references: [id])
  criadoEm      DateTime         @default(now())

  @@index([itemId, criadoEm])
  @@index([projetoId])
}
